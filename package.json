{
  "name": "@justinclayton/mcp-sync",
  "version": "0.1.5",
  "description": "Write your MCP config once, install it everywhere. Universal MCP configuration sync for Claude, Copilot, OpenCode, Cursor, and more.",
  "type": "module",
  "bin": {
    "mcp-sync": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node18 --outfile=dist/cli.js --format=esm --banner:js='#!/usr/bin/env node'",
    "dev": "node --import tsx src/cli.ts",
    "test": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "copilot",
    "opencode",
    "cursor",
    "ai",
    "config",
    "sync"
  ],
  "author": "Justin Clayton",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justinclayton/mcp-sync.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "esbuild": "^0.25.0",
    "picocolors": "^1.1.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^3.24.0"
  }
}
